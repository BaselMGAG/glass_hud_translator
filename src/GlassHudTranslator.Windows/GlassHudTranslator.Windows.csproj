<Project Sdk="Microsoft.NET.Sdk">

  <!-- Win32 implementations of the Core seams. Compiles on macOS; runs only on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GlassHudTranslator.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlassHudTranslator.Core\GlassHudTranslator.Core.csproj" />
    <ProjectReference Include="..\GlassHudTranslator.Interop\GlassHudTranslator.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- Bundles the native tesseract/leptonica DLLs so the user installs nothing. -->
    <PackageReference Include="TesseractOCR" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
