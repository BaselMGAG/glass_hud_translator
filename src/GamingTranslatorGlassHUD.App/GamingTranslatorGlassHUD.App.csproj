<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target so the platform analyzer keeps an honest line between "runs anywhere" and
      "Windows only". Build -f net10.0 on macOS; CI publishes -f net10.0-windows.
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GamingTranslatorGlassHUD.App</RootNamespace>
    <AssemblyName>GamingTranslatorGlassHUD</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Per-monitor-v2 DPI awareness. Windows-only concept; the manifest is ignored elsewhere. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamingTranslatorGlassHUD.Core\GamingTranslatorGlassHUD.Core.csproj" />
  </ItemGroup>

  <!-- The Win32 layer exists only under the Windows TFM. This is the whole platform seam. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\GamingTranslatorGlassHUD.Windows\GamingTranslatorGlassHUD.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
