<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!--
      Overridden by CI from the release tag (-p:Version=). A command-line property beats this one,
      so a local build is unambiguously 0.0.0 - which is what UpdateCheck reads as "running from
      source, stay quiet". Without a default here a local build reports 1.0.0, which is a version
      the project could plausibly reach, and every release would look like an update to a developer.
    -->
    <Version>0.0.0-dev</Version>

    <!--
      Stamped into every assembly, so a binary someone was handed carries its own licence and
      copyright rather than depending on a LICENSE file that travels separately. AGPL from v0.6.0;
      everything up to v0.5.3 shipped under Apache-2.0 and stays available under those terms.
      "or-later" is the FSF's own recommendation and is what makes a future move to AGPL-4 possible
      without tracking down every contributor.
    -->
    <Copyright>Copyright 2026 Basel</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CA1416</WarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <!--
      Lets net10.0-windows projects build on macOS/Linux. The TFM only applies
      [SupportedOSPlatform("windows")], which is an analyzer contract - it is UseWPF /
      UseWindowsForms that would make a Windows host mandatory, and we use neither.
      See PROJECT_PLAN.md 1.2.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
